FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me
DATABASE_URL=sqlite:///gateway.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_ANALYSIS_TIMEOUT_SECONDS=0
OLLAMA_GUARDIAN_MODEL=granite4.1-guardian:8b
APP_ENCRYPTION_KEY=
ENABLE_PROMPT_LOGGING=false
MAX_PROMPT_LENGTH=30000
EXPECTED_OUTPUT_RATIO=6
CARBON_INTENSITY_G_PER_KWH=350
# TDP der lokalen CPU in Watt, fuer Energie-/CO2-Schaetzung bei lokalen Ollama-Sends
# (CPU-Auslastung x TDP x Dauer -- Formel-Schaetzung, keine Hardware-Messung, siehe
# docs/CARBON_FOOTPRINT_REDESIGN.md). Leer lassen, wenn unbekannt: dann bleibt die
# Anzeige fuer lokale Sends "nicht verfuegbar" statt einen erfundenen Wert zu zeigen.
LOCAL_CPU_TDP_WATT=
ECOLOGITS_ENABLED=true
ECOLOGITS_ELECTRICITY_MIX_ZONE=DEU
ECOLOGITS_DEFAULT_DATACENTER_PUE=1.2
ECOLOGITS_DEFAULT_DATACENTER_WUE=1.8
